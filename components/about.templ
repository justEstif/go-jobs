package components

templ About() {
	@Layout("About") {
		<div class="max-w-2xl mx-auto">
			<h1 class="text-3xl font-bold mb-4">About This Template</h1>
			<p class="mb-4">This is a modern Go web application template featuring:</p>
			<ul class="list bg-base-100 rounded-box shadow-md mb-6">
				<li class="list-row"><strong>Chi</strong><span class="text-base-content/70 ml-2">Lightweight, idiomatic router</span></li>
				<li class="list-row"><strong>Templ</strong><span class="text-base-content/70 ml-2">Type-safe Go templates</span></li>
				<li class="list-row"><strong>HTMX</strong><span class="text-base-content/70 ml-2">Modern interactivity without JavaScript frameworks</span></li>
				<li class="list-row"><strong>Tailwind CSS + DaisyUI</strong><span class="text-base-content/70 ml-2">Utility-first CSS with component library</span></li>
				<li class="list-row"><strong>PostgreSQL</strong><span class="text-base-content/70 ml-2">Reliable, powerful database</span></li>
				<li class="list-row"><strong>sqlc</strong><span class="text-base-content/70 ml-2">Compile-time type-safe SQL queries</span></li>
				<li class="list-row"><strong>golang-migrate</strong><span class="text-base-content/70 ml-2">Database migration management</span></li>
			</ul>
			<div class="card bg-base-200 shadow-sm">
				<div class="card-body">
					<h2 class="card-title">Why This Stack?</h2>
					<p>This combination provides a productive, type-safe development experience with minimal JavaScript and maximum performance.</p>
				</div>
			</div>
		</div>
	}
}
