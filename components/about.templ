package components

templ About(loggedIn bool, csrfToken string) {
	@Layout("About", loggedIn, csrfToken) {
		<div class="max-w-2xl">
			<h1 class="text-2xl font-semibold mb-4">About</h1>
			<p class="text-base-content/70 mb-4">go-jobs is a self-hosted job aggregator that scrapes Greenhouse, Lever, and Ashby boards, enriches listings with structured metadata, and gives you a lightweight pipeline to track applications.</p>
			<ul class="divide-y divide-base-200 border border-base-200 rounded-sm mb-6">
				<li class="px-4 py-3 flex gap-3"><strong class="w-32 shrink-0">Chi</strong><span class="text-base-content/70">Lightweight, idiomatic router</span></li>
				<li class="px-4 py-3 flex gap-3"><strong class="w-32 shrink-0">Templ</strong><span class="text-base-content/70">Type-safe Go templates</span></li>
				<li class="px-4 py-3 flex gap-3"><strong class="w-32 shrink-0">HTMX</strong><span class="text-base-content/70">Modern interactivity without JavaScript frameworks</span></li>
				<li class="px-4 py-3 flex gap-3"><strong class="w-32 shrink-0">DaisyUI</strong><span class="text-base-content/70">Utility-first CSS with component library</span></li>
				<li class="px-4 py-3 flex gap-3"><strong class="w-32 shrink-0">PostgreSQL</strong><span class="text-base-content/70">Reliable, powerful database</span></li>
				<li class="px-4 py-3 flex gap-3"><strong class="w-32 shrink-0">sqlc</strong><span class="text-base-content/70">Compile-time type-safe SQL queries</span></li>
			</ul>
		</div>
	}
}
