package components

templ Home() {
	@Layout("Home") {
		<div class="hero min-h-[60vh]">
			<div class="hero-content text-center">
				<div class="max-w-md">
					<h1 class="text-5xl font-bold">Hello, World!</h1>
					<p class="py-6">Welcome to your new Go web application built with Chi, Templ, and HTMX.</p>
					<a href="/about" class="btn btn-primary">Learn More</a>
				</div>
			</div>
		</div>
	}
}
