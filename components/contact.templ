package components

templ Contact(loggedIn bool, csrfToken string) {
	@Layout("Contact", loggedIn, csrfToken) {
		<div class="max-w-md">
			<h1 class="text-2xl font-semibold mb-6">Contact</h1>
			<form
				hx-post="/contact"
				hx-target="#form-result"
				hx-swap="innerHTML"
				class="space-y-4"
			>
				<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
				<div class="form-control">
					<label class="label py-1">
						<span class="label-text text-xs uppercase tracking-wide">Name</span>
					</label>
					<input
						type="text"
						name="name"
						placeholder="Your name"
						class="input input-bordered input-sm"
						required
					/>
				</div>
				<div class="form-control">
					<label class="label py-1">
						<span class="label-text text-xs uppercase tracking-wide">Email</span>
					</label>
					<input
						type="email"
						name="email"
						placeholder="you@example.com"
						class="input input-bordered input-sm"
						required
					/>
				</div>
				<div class="form-control">
					<label class="label py-1">
						<span class="label-text text-xs uppercase tracking-wide">Message</span>
					</label>
					<textarea
						name="message"
						placeholder="Your message"
						class="textarea textarea-bordered textarea-sm h-24"
						required
					></textarea>
				</div>
				<button type="submit" class="btn btn-primary btn-sm">Send</button>
			</form>
			<div id="form-result" class="mt-4"></div>
		</div>
	}
}

templ ContactSuccess() {
	<div class="alert alert-success text-sm">
		<span>Message sent successfully.</span>
	</div>
}
