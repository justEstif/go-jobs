package components

// Navbar renders the top navigation bar.
//
// When adding auth state, follow these patterns to avoid common bugs:
//
// 1. Logout must be a form POST (not <a href>) to carry the CSRF token.
//    Using <a href="/logout"> will return 403 Forbidden.
//
//	<form method="post" action="/logout">
//	    <input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
//	    <button type="submit">Sign out</button>
//	</form>
//
// 2. OAuth login links must use hx-boost="false" so HTMX does not intercept
//    the redirect. Without it, the OAuth provider redirect causes a CORS error.
//
//	<a href="/auth/google/login" hx-boost="false">Continue with Google</a>
//
// 3. OAuth connect buttons (e.g. "Connect Spotify") must be hx-post triggers,
//    not plain <a href>, since the initiation route is a POST handler.
//    Using <a href> will return 405 Method Not Allowed.
templ Navbar(loggedIn bool, csrfToken string) {
	<header class="border-b border-base-200 bg-base-100">
		<div class="container mx-auto px-4 flex items-center justify-between h-12">
			<a href="/" class="text-sm font-semibold tracking-tight text-base-content">go-jobs</a>
			<nav class="flex items-center gap-1">
				if loggedIn {
				<a href="/" class="btn btn-ghost btn-xs">Jobs</a>
				<a href="/pipeline" class="btn btn-ghost btn-xs">Pipeline</a>
				<a href="/coach" class="btn btn-ghost btn-xs">Coach</a>
				<a href="/settings" class="btn btn-ghost btn-xs">Settings</a>
					<form method="post" action="/logout" class="inline">
						<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
						<button type="submit" class="btn btn-ghost btn-xs">Sign out</button>
					</form>
				} else {
					<a href="/login" class="btn btn-ghost btn-xs">Sign in</a>
					<a href="/register" class="btn btn-primary btn-xs">Register</a>
				}
			</nav>
		</div>
	</header>
}
