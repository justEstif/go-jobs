package components

// RegisterPage renders the account registration form.
// errMsg is displayed when non-empty (e.g. "email already taken").
templ RegisterPage(errMsg string, csrfToken string) {
	@Layout("Create account", false, csrfToken) {
		<div class="max-w-sm mx-auto mt-16">
			<h1 class="text-2xl font-semibold mb-6">Create account</h1>
			if errMsg != "" {
				<div class="alert alert-error mb-4 text-sm">
					<span>{ errMsg }</span>
				</div>
			}
			<form method="POST" action="/register" class="space-y-4">
				<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
				<fieldset class="fieldset">
					<label class="label py-1">
						<span class="label-text text-xs uppercase tracking-wide">Email</span>
					</label>
					<input
						type="email"
						name="email"
						placeholder="you@example.com"
						class="input input-bordered input-sm"
						required
					/>
				</fieldset>
				<fieldset class="fieldset">
					<label class="label py-1">
						<span class="label-text text-xs uppercase tracking-wide">Password</span>
					</label>
					<input
						type="password"
						name="password"
						placeholder="••••••••"
						class="input input-bordered input-sm"
						required
					/>
				</fieldset>
				<button type="submit" class="btn btn-primary btn-sm">Create account</button>
			</form>
			<p class="mt-4 text-sm text-center text-base-content/60">
				Already have an account?
				<a href="/login" class="link link-primary">Sign in</a>
			</p>
		</div>
	}
}

// LoginPage renders the sign-in form.
// errMsg is displayed when non-empty (e.g. "Invalid email or password").
templ LoginPage(errMsg string, csrfToken string) {
	@Layout("Sign in", false, csrfToken) {
		<div class="max-w-sm mx-auto mt-16">
			<h1 class="text-2xl font-semibold mb-6">Sign in</h1>
			if errMsg != "" {
				<div class="alert alert-error mb-4 text-sm">
					<span>{ errMsg }</span>
				</div>
			}
			<form method="POST" action="/login" class="space-y-4">
				<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
				<fieldset class="fieldset">
					<label class="label py-1">
						<span class="label-text text-xs uppercase tracking-wide">Email</span>
					</label>
					<input
						type="email"
						name="email"
						placeholder="you@example.com"
						class="input input-bordered input-sm"
						required
					/>
				</fieldset>
				<fieldset class="fieldset">
					<label class="label py-1">
						<span class="label-text text-xs uppercase tracking-wide">Password</span>
					</label>
					<input
						type="password"
						name="password"
						placeholder="••••••••"
						class="input input-bordered input-sm"
						required
					/>
				</fieldset>
				<button type="submit" class="btn btn-primary btn-sm">Sign in</button>
			</form>
			<p class="mt-4 text-sm text-center text-base-content/60">
				Don't have an account?
				<a href="/register" class="link link-primary">Create one</a>
			</p>
		</div>
	}
}
