# go-jobs production environment variables
# Copy to .env.production and fill in real values.
# Never commit .env.production to version control.

# ─────────────────────────────────────────────
# Common (required for all deployment methods)
# ─────────────────────────────────────────────

# Public URL of the app (no trailing slash)
BASE_URL=https://jobs.your.domain

# CSRF cookie signing key — exactly 32 hex chars (16 bytes)
# Generate: openssl rand -hex 16
CSRF_KEY=

# Session cookie signing secret
# Generate: openssl rand -hex 16
SESSION_SECRET=

# AES-256-GCM key for encrypting stored LLM API keys — exactly 64 hex chars (32 bytes)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# Dokku
# Dokku manages Postgres and injects DATABASE_URL automatically.
# These are read by scripts/deploy-app.sh at provision time.
# ─────────────────────────────────────────────

# Server IP or hostname (e.g. 1.2.3.4 or dokku.myserver.com)
DOKKU_HOST=

# Dokku app name (e.g. go-jobs)
APP_NAME=

# Public domain to assign to the app (e.g. jobs.yourdomain.com)
DOMAIN=

# ─────────────────────────────────────────────
# Docker Compose (docker-compose.prod.yml)
# Used to configure the bundled Postgres container.
# Not needed if using Dokku.
# ─────────────────────────────────────────────

# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=
